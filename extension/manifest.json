{
  "manifest_version": 3,
  "name": "Sujib - YouTube Downloader",
  "version": "1.0.0",
  "description": "Envoyez en un clic n'importe quelle vidéo YouTube vers votre serveur Sujib.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Envoyer à Sujib"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sujib-downloader@mediapixel.kr",
      "update_url": "http://192.168.200.15/sujib/static/extension-update.json"
    }
  }
}
