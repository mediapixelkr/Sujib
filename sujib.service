[Unit]
Description=Sujib - YouTube Video Download Manager
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/sujib
ExecStart=/var/www/html/sujib/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
